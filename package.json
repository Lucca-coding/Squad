{
  "name": "squad-desktop",
  "version": "1.0.0",
  "description": "SQUAD — Your Friends. Your Games. Your Squad.",
  "author": "SQUAD",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node -e \"const fs=require('fs');fs.rmSync('app',{recursive:true,force:true});fs.mkdirSync('app');for(const f of ['index.html','config.js','logo.png','mark.png','icon.png'])if(fs.existsSync(f))fs.copyFileSync(f,'app/'+f)\"",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.squad.app",
    "productName": "SQUAD",
    "files": [
      "main.js",
      "app/**"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "SQUAD-${os}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O SQUAD usa o microfone nas chamadas de voz.",
        "NSCameraUsageDescription": "O SQUAD usa a câmera nas chamadas de vídeo."
      }
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
